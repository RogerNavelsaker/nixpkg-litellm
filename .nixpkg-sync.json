{
  "kind": "none",
  "upstream": "https://github.com/BerriAI/litellm.git",
  "tag_regex": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "tag_prefix": "v",
  "version_file": "flake.nix",
  "version_grep": "version = \"[0-9]+\\.[0-9]+\\.[0-9]+\"",
  "pinned_paths": [],
  "pinned_flake_regex": "litellm-src|revision =|cargoDeps|hash =",
  "sync_script": "bash scripts/sync-from-git-tag.sh"
}
